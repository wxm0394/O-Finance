# ==============================================================================
# O-Finance Backend Environment Configuration (Template)
# DO NOT COMMIT REAL CREDENTIALS OR KEYS TO VERSION CONTROL.
# Copy this file to backend/.env for local deployment.
# ==============================================================================

# Application Runtime
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Frontend CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL 16 Database Connection (psycopg 3 async driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://ofinance_admin:change_me_local_password@127.0.0.1:5432/ofinance_core

# AI Model Provider Configuration
# Supported providers: "Gemini" (Default for Cloud) or "Local Ollama" (Offline)
LLM_PROVIDER=Gemini

# Google Gemini API Credential (Phase 1 Sole Cloud AI Provider)
# Obtain from Google AI Studio: https://aistudio.google.com/
# Strictly kept on local Python backend; NEVER exposed to frontend or logged.
GEMINI_API_KEY=

# Optional Local Ollama Endpoint (Used when LLM_PROVIDER="Local Ollama")
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Authoritative Beancount Ledger File Path (Display & Future Bridge)
BEANCOUNT_FILE_PATH=~/o-finance/ledger/main.beancount

# Fava Web Server URL
FAVA_SERVER_URL=http://127.0.0.1:5000

# External Research Service Placeholder (daily_stock_analysis connector)
DAILY_ANALYSIS_API_URL=http://127.0.0.1:8090/api/v1/reports
